# Required. Your Gateframe API token.
GATEFRAME_API_KEY=gf_your_token_here

# Required. Gateframe base URL. Prefer https://. `/v1` is optional — the
# extension normalizes the URL either way.
GATEFRAME_BASE_URL=https://your-gateframe-host

# Optional. Path to a JSON file overriding per-model metadata (context
# window, max tokens, reasoning, cost, compat). See
# .pi/extensions/gateframe-provider/gateframe-model-overrides.example.json
# GATEFRAME_MODEL_OVERRIDES_PATH=/absolute/path/to/model-overrides.json
